{
  "name": "thesis-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "论文研究与写作工作台（本地运行，暂用名）——阶段 1：项目基础",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsup --watch\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV_URL=http://localhost:5173 electron .\"",
    "build": "vite build && tsup",
    "build:renderer": "vite build",
    "build:electron": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "npm run build:electron && playwright test --config=playwright.electron.config.ts",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "docx": "^9.16.0",
    "fast-xml-parser": "^5.12.1",
    "jszip": "^3.10.2",
    "undici": "^8.12.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vite": "^6.3.5",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
